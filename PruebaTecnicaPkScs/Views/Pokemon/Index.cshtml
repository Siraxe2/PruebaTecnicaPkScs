@model PruebaTecnicaPkScs.Models.PokemonIndexViewModel

@{
    ViewData["Title"] = "Pokémones";
}

<div class="container py-4">
    <h1 class="mb-2">Pokémones</h1>

    <form asp-controller="Pokemon"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-4">
            <label for="name" class="form-label">
                Nombre del Pokémon
            </label>

            <input type="text"
                   id="name"
                   name="name"
                   value="@Model.Name"
                   class="form-control"
                   placeholder="" />
        </div>

        <div class="col-md-4">
            <label for="species" class="form-label">
                Especie
            </label>

            <select id="species"
                    name="species"
                    class="form-select">

                <option value="">Todas las especies</option>

                @foreach (var speciesName in Model.SpeciesNames)
                {
                    if (Model.SelectedSpecies == speciesName)
                    {
                        <option value="@speciesName" selected>
                            @speciesName
                        </option>
                    }
                    else
                    {
                        <option value="@speciesName">
                            @speciesName
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">
                Buscar
            </button>
        </div>

        <div class="col-auto align-self-end">
            <a asp-controller="Pokemon"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Limpiar
            </a>
        </div>
    </form>

    @if (ViewData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }
    else
    {
        <p>
            @if (!string.IsNullOrWhiteSpace(Model.Name))
            {
                <span>
                    Coincidencias para
                    <strong>@Model.Name</strong>:
                </span>
            }
            else
            {
                <span>Pokémones disponibles:</span>
            }

            <strong>@Model.TotalMatches</strong>
        </p>

        @if (Model.TotalMatches == 0)
        {
            <div class="alert alert-info" role="status">
                No se encontraron Pokémones con ese nombre.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2
                row-cols-md-3 row-cols-lg-4 g-4">

                @foreach (var pokemon in Model.Pokemon)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">

                            <div class="bg-light d-flex
                                align-items-center
                                justify-content-center p-3"
                                 style="height: 180px;">

                                <img src="@pokemon.ImageUrl"
                                     alt="Imagen de @pokemon.Name"
                                     class="img-fluid"
                                     style="max-height: 150px;
                                object-fit: contain;"
                                     loading="lazy" />
                            </div>

                            <div class="card-body text-center">
                                <h2 class="card-title h5 text-capitalize">
                                    @pokemon.Name
                                </h2>

                                <p class="text-muted small mb-0">
                                    N. @pokemon.Id
                                </p>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

    }
</div>