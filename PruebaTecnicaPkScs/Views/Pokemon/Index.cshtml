@model PruebaTecnicaPkScs.Models.PokemonListResponse

@{
    ViewData["Title"] = "Pokémones";
}

<div class="container py-4">
    <div class="d-flex justify-content-between
        align-items-center flex-wrap gap-2 mb-4">

        <div>
            <h1 class="mb-1">Pokémones</h1>
        </div>

        <span class="badge bg-primary fs-6">
            @Model.Results.Count Pokémones
        </span>
    </div>

    @if (ViewData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }
    else if (Model.Results.Count == 0)
    {
        <div class="alert alert-info" role="status">
            No se encontraron Pokémones.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2
            row-cols-md-3 row-cols-lg-4 g-4">

            @foreach (var pokemon in Model.Results)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">

                        <div class="bg-light d-flex
                            align-items-center
                            justify-content-center p-3"
                             style="height: 180px;">

                            <img src="@pokemon.ImageUrl"
                                 alt="Imagen de @pokemon.Name"
                                 class="img-fluid"
                                 style="max-height: 150px;
                            object-fit: contain;"
                                 loading="lazy" />
                        </div>

                        <div class="card-body text-center">
                            <h2 class="card-title h5 text-capitalize">
                                @pokemon.Name
                            </h2>

                            <p class="text-muted small mb-0">
                                N. @pokemon.Id
                            </p>
                        </div>

                    </div>
                </div>
            }
        </div>

        <p class="text-muted small mt-4">
            Total de Pokémones de la API:
            @Model.Count
        </p>
    }
</div>