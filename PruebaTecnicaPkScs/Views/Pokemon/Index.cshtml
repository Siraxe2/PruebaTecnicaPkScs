@model PruebaTecnicaPkScs.Models.PokemonIndexViewModel

@{
    ViewData["Title"] = "Pokémones";
}

<div class="container py-4">
    <h1 class="mb-2">Pokémones</h1>

    @if (TempData["EmailSuccess"] is string emailSuccess)
    {
        <div class="alert alert-success" role="status">
            @emailSuccess
        </div>
    }

    @if (TempData["EmailError"] is string emailError)
    {
        <div class="alert alert-danger" role="alert">
            @emailError
        </div>
    }

    <form asp-controller="Pokemon"
          asp-action="Index"
          method="get"
          class="row g-3 mb-4">

        <div class="col-md-4">
            <label for="name" class="form-label">
                Nombre del Pokémon
            </label>

            <input type="text"
                   id="name"
                   name="name"
                   value="@Model.Name"
                   class="form-control"
                   placeholder="" />
        </div>

        <div class="col-md-4">
            <label for="species" class="form-label">
                Especie
            </label>

            <select id="species"
                    name="species"
                    class="form-select">

                <option value="">Todas las especies</option>

                @foreach (var speciesName in Model.SpeciesNames)
                {
                    if (Model.SelectedSpecies == speciesName)
                    {
                        <option value="@speciesName" selected>
                            @speciesName
                        </option>
                    }
                    else
                    {
                        <option value="@speciesName">
                            @speciesName
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">
                Buscar
            </button>
        </div>

        <div class="col-auto align-self-end">
            <a asp-controller="Pokemon"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Limpiar
            </a>
        </div>
    </form>

    @if (ViewData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }
    else
    {
        @if (Model.Pokemon.Count > 0)
        {
            <div class="row g-3 mb-4">

                <div class="col-md-5">
                    <form asp-controller="Pokemon"
                          asp-action="ExportExcel"
                          method="get"
                          class="border rounded p-3 h-100">

                        <input type="hidden"
                               name="name"
                               value="@Model.Name" />

                        <input type="hidden"
                               name="species"
                               value="@Model.SelectedSpecies" />

                        <input type="hidden"
                               name="page"
                               value="@Model.CurrentPage" />

                        <h2 class="h6">Exportación</h2>

                        <br />

                        <button type="submit"
                                class="btn btn-success">
                            Exportar a Excel
                        </button>
                    </form>
                </div>

                <div class="col-md-7">
                    <form asp-controller="Pokemon"
                          asp-action="SendPageEmail"
                          method="post"
                          class="border rounded p-3 h-100">

                        <input type="hidden"
                               name="name"
                               value="@Model.Name" />

                        <input type="hidden"
                               name="species"
                               value="@Model.SelectedSpecies" />

                        <input type="hidden"
                               name="page"
                               value="@Model.CurrentPage" />

                        <label for="recipientEmailPage"
                               class="form-label">
                            Correo del destinatario
                        </label>

                        <input type="email"
                               id="recipientEmailPage"
                               name="recipientEmail"
                               class="form-control mb-3"
                               maxlength="254"
                               required />

                        <button type="submit"
                                class="btn btn-primary">
                            Enviar página actual
                        </button>
                    </form>
                </div>

            </div>
        }

        <p>
            @if (!string.IsNullOrWhiteSpace(Model.Name))
            {
                <span>
                    Coincidencias para
                    <strong>@Model.Name</strong>:
                </span>
            }
            else
            {
                <span>Pokémones disponibles:</span>
            }

            <strong>@Model.TotalMatches</strong>
        </p>

        @if (Model.TotalMatches == 0)
        {
            <div class="alert alert-info" role="status">
                No se encontraron Pokémones con ese nombre.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2
                row-cols-md-3 row-cols-lg-4 g-4">

                @foreach (var pokemon in Model.Pokemon)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">

                            <a asp-controller="Pokemon"
                               asp-action="Details"
                               asp-route-id="@pokemon.Id"
                               class="text-decoration-none text-reset">

                                <div class="bg-light d-flex
                                    align-items-center justify-content-center p-3"
                                     style="height: 180px;">

                                    <img src="@pokemon.ImageUrl"
                                         alt="Imagen de @pokemon.Name"
                                         class="img-fluid"
                                         style="max-height: 150px;
                                    object-fit: contain;"
                                         loading="lazy" />
                                </div>

                                <div class="card-body text-center">
                                    <h2 class="card-title h5 text-capitalize">
                                        @pokemon.Name
                                    </h2>

                                    <p class="text-muted small mb-0">
                                        N. @pokemon.Id
                                    </p>

                                    <span class="small text-primary">
                                        Ver detalles
                                    </span>
                                </div>
                            </a>

                            <div class="card-footer bg-white">
                                <form asp-controller="Pokemon"
                                      asp-action="SendPokemonEmail"
                                      method="post">

                                    <input type="hidden"
                                           name="id"
                                           value="@pokemon.Id" />

                                    <input type="hidden"
                                           name="name"
                                           value="@Model.Name" />

                                    <input type="hidden"
                                           name="species"
                                           value="@Model.SelectedSpecies" />

                                    <input type="hidden"
                                           name="page"
                                           value="@Model.CurrentPage" />

                                    <div class="mb-2">
                                        <label for="recipientEmail-@pokemon.Id"
                                               class="form-label small">
                                            Correo del destinatario
                                        </label>

                                        <input type="email"
                                               id="recipientEmail-@pokemon.Id"
                                               name="recipientEmail"
                                               class="form-control form-control-sm"
                                               maxlength="254"
                                               required />
                                    </div>

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm w-100">
                                        Enviar este Pokémon
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Paginación de Pokémon" class="mt-4">
                <div class="d-flex justify-content-center
                    align-items-center gap-3">

                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-controller="Pokemon"
                           asp-action="Index"
                           asp-route-name="@Model.Name"
                           asp-route-species="@Model.SelectedSpecies"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           class="btn btn-outline-primary">
                            Anterior
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary"
                                disabled>
                            Anterior
                        </button>
                    }

                    <span>
                        Página @Model.CurrentPage
                        de @Model.TotalPages
                    </span>

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-controller="Pokemon"
                           asp-action="Index"
                           asp-route-name="@Model.Name"
                           asp-route-species="@Model.SelectedSpecies"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           class="btn btn-outline-primary">
                            Siguiente
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary"
                                disabled>
                            Siguiente
                        </button>
                    }

                </div>
            </nav>
        }
    }
</div>